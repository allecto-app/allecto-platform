{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "typeRoots": [
      "../../types",
      "./node_modules/@types",
      "../../node_modules/@types"
    ],
    "paths": {
      "bcryptjs": ["../../types/bcryptjs"]
    }
  }
}
