{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": { "cache": false, "persistent": true },
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", ".next/**"], "env": ["NEXT_PUBLIC_CONVEX_URL", "RESEND_API_KEY", "EMAIL_FROM", "NPM_AUTH_TOKEN"] },
    "lint": {},
    "test": { "dependsOn": ["^build"] }
  }
}
